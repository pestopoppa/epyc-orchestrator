.env

# Orchestration transient files
orchestration/last_task_ir.json
orchestration/last_architecture_ir.json
orchestration/gate_report_*.json
orchestration/runtime_flags.json

# Tool plugin settings (per-user configuration)
src/tool_settings/

# MemRL data files (generated at runtime)
orchestration/repl_memory/embeddings.npy
orchestration/repl_memory/episodic.db
orchestration/repl_memory/sessions/

# Claude Code config
.claude/
.gitnexus

# Benchmark images (large, not tracked)
benchmarks/images/

# Binary data artifacts (FAISS indexes, numpy arrays, model weights, embeddings)
*.faiss
*.npy
*.npz
*.pkl
*.pickle
*.pt
*.pth
*.safetensors
*.bin

# Core dumps + perf captures
core
core.*
perf.data
perf.data.*
perf-*.data

# Model files (should be in /mnt/raid0/llm/models/, not repos)
*.gguf
*.ggml

# Autopilot runtime state (checkpoints can be multi-GB; journals + plots are ephemeral)
orchestration/.autopilot.lock
orchestration/archived_backups/
orchestration/autopilot_checkpoints/
orchestration/autopilot_journal.*
orchestration/autopilot_plots/
orchestration/autopilot_state.json*

# One-off local observation helpers from contention/autopilot experiments.
scripts/server/_step1_obs_sampler.sh

# Lean-registry compile cache key (regenerated by registry_compiler.py)
orchestration/.lean_cache_key

# Test artifacts (MagicMock-as-path, etc.)
MagicMock/

# Generated benchmark/preflight artifacts. Keep curated fixtures in these
# directories tracked; ignore only ad-hoc run outputs.
data/bep_sandbox/results-*/
data/bep_sandbox/INVALID-*/
data/contention_matrix/affinity_preflight_*.json

# Local SearxNG config export/scratch files
config/searxng/*.new

# Editor backups
*~

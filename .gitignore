.coverage
coverage.json
htmlcov/

# Databases
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Trace + KB-RAG derived data (rebuildable from sources)
data/trace/
data/kb_rag/

# Reviewer rubric cache (rebuildable — re-authoring re-populates; RD-2)
data/review/

# Logs and runtime data
logs/
*.log

# Caches
cache/
share/
state/

# Temporary files
tmp/
*.tmp
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.sublime-*

# Environment
.env

# Orchestration transient files
orchestration/last_task_ir.json
orchestration/last_architecture_ir.json
orchestration/gate_report_*.json
# Live feature-flag overlay: rewritten by the API at runtime, so tracking it
# would churn every run and conflict across sessions sharing this clone. The
# TRACKED counterpart a clone needs is orchestration/runtime_flags.spec.yaml
# (declared posture); diff the two with scripts/validate/runtime_flags_drift.py.
orchestration/runtime_flags.json

# Tool plugin settings (per-user configuration)
src/tool_settings/

# MemRL data files (generated at runtime)
orchestration/repl_memory/embeddings.npy
orchestration/repl_memory/episodic.db
orchestration/repl_memory/sessions/

# Claude Code config
.claude/
.gitnexus

# Benchmark images (large, not tracked)
benchmarks/images/

# Binary data artifacts (FAISS indexes, numpy arrays, model weights, embeddings)
*.faiss
*.npy
*.npz
*.pkl
*.pickle
*.pt
*.pth
*.safetensors
*.bin

# Core dumps + perf captures
core
core.*
perf.data
perf.data.*
perf-*.data

# Model files (should be in /mnt/raid0/llm/models/, not repos)
*.gguf
*.ggml

# Autopilot runtime state (checkpoints can be multi-GB; journals + plots are ephemeral)
orchestration/.autopilot.lock
orchestration/autopilot.lock
orchestration/archived_backups/
orchestration/autopilot_checkpoints/
orchestration/autopilot_journal.*
# The journal ROTATES to `autopilot_journal_<n>.jsonl`, which the pattern above does not
# match (it requires a literal dot after "journal"). Shard 1 reached 17 MB tracked before
# anyone noticed. Runtime data belongs on disk, not in the repo.
orchestration/autopilot_journal_*
orchestration/autopilot_plots/
orchestration/autopilot_short_term_memory.md
orchestration/autopilot_state.json*
orchestration/autopilot_state.pre-*.json
# Eval-instrument identity ledger (2026-08-04): per-core_id content hash + tier mix, written
# on every eval. Runtime state, same class as autopilot_state.json.
orchestration/eval_instrument_ledger.json
# Kuzu graph stores + their write-ahead logs.
orchestration/repl_memory/kuzu_db/

# One-off local observation helpers from contention/autopilot experiments.
scripts/server/_step1_obs_sampler.sh

# Lean-registry compile cache key (regenerated by registry_compiler.py)
orchestration/.lean_cache_key

# Test artifacts (MagicMock-as-path, etc.)
MagicMock/

# Generated benchmark/preflight artifacts. Keep curated fixtures in these
# directories tracked; ignore only ad-hoc run outputs.
data/bep_sandbox/results-*/
data/bep_sandbox/INVALID-*/
data/contention_matrix/affinity_preflight_*.json

# Local SearxNG config export/scratch files
config/searxng/*.new

# Editor backups
*~
\#*\#
.\#*

# generated attestation snapshots (regenerated by scripts/attest/generate_attestation.py)
orchestration/attestation/*.json
orchestration/authority_consent.json

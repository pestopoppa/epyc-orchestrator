{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestopoppa/amd-epyc-inference/schemas/verification_report.schema.json",
  "title": "VerificationReport",
  "description": "Normalized objective-verifier output (gate_runner.GateResult + eval-tower tier scorers + math/retrieval/constraint checkers). Each check carries a THREE-VALUED outcome pass|fail|inconclusive: verifier precedence over the reviewer applies ONLY to conclusive (pass/fail) verdicts, because formalization incompleteness yields ~15% false-positives (Sistla 2509.26546). A FAIL check MUST carry a `certificate` (failing assertion / counterexample / unsat core / diff / trace) — that is the request_evidence payload (intake-842/843). Immutable once emitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "checks"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Artifact schema version (semver)."
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this verification report."
    },
    "candidate_ref": {
      "type": "string",
      "description": "package_id of the CandidatePackage verified."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rollup of check outcomes.",
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "conclusive_verdict": {
          "type": "string",
          "enum": ["pass", "fail", "inconclusive"],
          "description": "Aggregate verdict; 'inconclusive' whenever any required check is inconclusive."
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "description": "Per-check normalized results.",
      "items": { "$ref": "#/$defs/check" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "runner": { "type": "string" },
        "instrument_era": { "type": "string" }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "kind", "outcome"],
      "description": "One normalized verifier result. A FAIL requires a certificate; an INCONCLUSIVE requires an inconclusive_reason.",
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier for this check (gate_name, test id, scorer id, tier id)."
        },
        "kind": {
          "type": "string",
          "enum": [
            "gate",
            "test",
            "lint",
            "typecheck",
            "format",
            "build",
            "scorer",
            "retrieval_check",
            "math_check",
            "constraint_check",
            "tier"
          ],
          "description": "Verifier family (domain-general — not only code gates)."
        },
        "outcome": {
          "type": "string",
          "enum": ["pass", "fail", "inconclusive"],
          "description": "Three-valued outcome. Precedence over reviewer applies only to pass/fail."
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "Whether this check is required for the aggregate conclusive_verdict."
        },
        "instrument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "description": "Instrument identity + version producing this outcome (MEASUREMENT.md attestation).",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "certificate": { "$ref": "#/$defs/certificate" },
        "inconclusive_reason": {
          "type": "string",
          "description": "Why the verifier could not conclude (timeout, unsupported construct, formalization gap)."
        },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "exit_code": { "type": "integer" },
        "output": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "fail" } },
            "required": ["outcome"]
          },
          "then": { "required": ["certificate"] }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "inconclusive" } },
            "required": ["outcome"]
          },
          "then": { "required": ["inconclusive_reason"] }
        }
      ]
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "description": "Machine-checkable witness for a FAIL — the request_evidence payload handed back to the author.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "failing_assertion",
            "counterexample",
            "unsat_core",
            "diff",
            "stack_trace",
            "scorer_detail",
            "constraint_violation"
          ]
        },
        "payload": {
          "description": "The witness content (string or structured object).",
          "type": ["string", "object", "array"]
        },
        "location": {
          "type": "string",
          "description": "Where the failure occurs (path:line, answer span, etc.)."
        }
      }
    }
  }
}
